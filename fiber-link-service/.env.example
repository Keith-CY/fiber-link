# Fiber Link RPC service

# Postgres connection string for Drizzle runtime and migrations
DATABASE_URL=

# Shared nonce cache (use Redis for multi-instance deployments)
FIBER_LINK_NONCE_REDIS_URL=

# HMAC secrets (single-tenant fallback or per-app map)
FIBER_LINK_HMAC_SECRET=
FIBER_LINK_HMAC_SECRET_MAP=
# Accept legacy v1 RPC signatures that do not cover x-app-id (migration only; default false)
RPC_ALLOW_LEGACY_SIGNATURE=false

# Fiber node RPC endpoint (required)
FIBER_RPC_URL=

# Settlement subscription endpoint (worker uses this when strategy=subscription)
# Leave empty to keep polling-only fallback.
FIBER_SETTLEMENT_SUBSCRIPTION_URL=
WORKER_SETTLEMENT_STRATEGY=subscription
