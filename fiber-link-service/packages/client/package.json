{
  "name": "@fiber-link/client",
  "version": "0.1.0",
  "description": "Platform-agnostic JavaScript SDK for Fiber Link tipping",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "sideEffects": false,
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "test": "vitest",
    "typecheck": "tsc --noEmit",
    "prepack": "tsc --noEmit && tsup"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "tsup": "^8",
    "typescript": "^5.6.0",
    "vitest": "^1.6.0",
    "zod": "^3.23.8"
  }
}
